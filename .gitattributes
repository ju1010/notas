# Normaliza finales de línea por tipo de archivo.
# Sin esto, git en Windows guarda el .command con CRLF y macOS no lo puede ejecutar
# ("bad interpreter: /bin/bash^M").

* text=auto

*.command text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
# El .bat va con CRLF tambien dentro del repo: cmd.exe tolera LF en la mayoria
# de los casos, pero no siempre, y el ZIP de GitHub no convierte finales de linea.
*.bat     binary

*.ico     binary
*.png     binary
*.min.js  binary
